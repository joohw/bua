{
  "manifest_version": 3,
  "name": "BUA — Browser Use Agent",
  "short_name": "BUA",
  "homepage_url": "https://joohw.github.io/bua/",
  "version": "0.1.1",
  "description": "让任意 Agent 操作用户真实浏览器：读取页面、点击、输入、截图。真实标签页与登录态，无需重启浏览器。",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BUA — 设置"
  },
  "options_page": "onboarding.html",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [],
  "web_accessible_resources": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
