{
  "name": "@bua/extension",
  "version": "0.1.1",
  "description": "BUA Chrome MV3 扩展：通过 chrome.debugger 操作用户真实浏览器。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/demo-overlay.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=20000 test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=180000 test/e2e/*.test.mjs",
    "demo": "node scripts/demo-overlay.mjs",
    "preflight": "node scripts/preflight.mjs",
    "pack": "node scripts/pack.mjs",
    "release": "node scripts/build.mjs && node scripts/preflight.mjs && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@bua/protocol": "workspace:*",
    "@bua/server": "workspace:*",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.2",
    "puppeteer-core": "^25.13.0",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
