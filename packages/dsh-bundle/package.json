{
  "name": "dsh-plugin-bua",
  "version": "0.0.1",
  "license": "MIT",
  "homepage": "https://joohw.github.io/bua/",
  "repository": { "type": "git", "url": "git+https://github.com/joohw/bua.git", "directory": "packages/dsh-bundle" },
  "bugs": { "url": "https://github.com/joohw/bua/issues" },
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "publishConfig": { "access": "public" },
  "type": "module",
  "description": "BUA native DeepSeek Harness plugin with an automatically managed local browser bridge.",
  "keywords": ["dsh-plugin", "deepseek-harness", "browser", "browser-automation", "agent", "cordis"],
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=1 --test-timeout=20000 test/*.test.mjs"
  },
  "dependencies": { "ws": "^8.18.0" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.4", "@deepseek-ai/dsh-tools": "0.0.1-rc.1" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/dsh-tools": { "optional": true } },
  "devDependencies": { "@bua/server": "workspace:*", "@bua/sdk": "workspace:*", "@bua/protocol": "workspace:*", "esbuild": "^0.24.2", "@deepseek-ai/cordis": "^4.0.4", "@deepseek-ai/dsh-tools": "0.0.1-rc.1" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
