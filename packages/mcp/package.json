{
  "name": "@bua/mcp",
  "version": "0.0.1",
  "description": "BUA 的 MCP 服务器：把浏览器操作能力暴露给任意支持 MCP 的 agent（DSH / Claude Code / Codex）。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bua-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 test/*.test.mjs"
  },
  "dependencies": {
    "@bua/protocol": "workspace:*",
    "@bua/sdk": "workspace:*",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@bua/server": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
