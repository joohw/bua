{
  "name": "bua",
  "version": "0.0.1",
  "private": true,
  "description": "BUA — Browser Use Agent. 让任意 Agent 操作用户真实浏览器的通用能力层。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
